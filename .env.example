
# ==========================================
# GENEWEAVER APPLICATION CONFIGURATION
# ==========================================

GW_APP_NAME=GeneWeaver
GW_APP_VERSION=0.1.0
GW_ENVIRONMENT=development
GW_DEBUG=true
GW_LOG_LEVEL=INFO

# ==========================================
# DATABASE CONFIGURATION
# ==========================================

GW_DATABASE_URL=postgresql+psycopg://geneweaver:change-me@localhost:5432/geneweaver

# ==========================================
# REDIS CONFIGURATION
# ==========================================

redis_url: str = "redis://localhost:6379/0"
# ==========================================
# SEQUENCE PROCESSING
# ==========================================

GW_MAX_UPLOAD_SIZE_MB=100
GW_MAX_SEQUENCE_LENGTH=10000000
GW_ALIGNMENT_BACKEND=cpu

# ==========================================
# API CONFIGURATION
# ==========================================

GW_API_PREFIX=/api/v1
GW_CORS_ORIGINS=["http://localhost:3000"]
